<mxfile host="app.diagrams.net" modified="2026-10-19T00:00:00.000Z" agent="Codex" version="24.7.17" type="device">
  <diagram id="utm-hld-v1" name="UTM High-Level Design">
    <mxGraphModel dx="1800" dy="1280" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1280" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>

        <!-- Page title and status -->
        <mxCell id="title" value="High-Level Design | Simulation-to-Service Architecture" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=29;fontStyle=1;fontColor=#172B43;" vertex="1" parent="1"><mxGeometry x="42" y="24" width="1500" height="40" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Drone traffic management startup • V1 is a local simulation/API milestone on a path to a separately defined real service" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=14;fontColor=#52677F;" vertex="1" parent="1"><mxGeometry x="43" y="60" width="1600" height="28" as="geometry"/></mxCell>
        <mxCell id="status" value="IMPLEMENTATION STATUS&lt;br&gt;Shared Pydantic contracts and local mock API are present. Simulator, policy, safety filter, run orchestration, and end-to-end logging remain planned." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;fillColor=#FFF7E6;strokeColor=#E6B85C;strokeWidth=1.5;fontSize=13;fontColor=#744B0B;" vertex="1" parent="1"><mxGeometry x="40" y="98" width="1720" height="50" as="geometry"/></mxCell>

        <!-- System boundaries and owner lanes -->
        <mxCell id="v1" value="V1 LOCAL SIMULATION / API BOUNDARY     •     Synthetic inputs only • local Python control loop • no live aircraft or external UTM calls" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=14;spacingLeft=24;fillColor=#FFFFFF;strokeColor=#8395AA;strokeWidth=1.6;fontSize=15;fontStyle=1;fontColor=#172B43;" vertex="1" parent="1"><mxGeometry x="310" y="170" width="1450" height="670" as="geometry"/></mxCell>
        <mxCell id="aman_lane" value="AMAN | PRODUCT &amp; INTEGRATION" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=13;spacingLeft=18;fillColor=#F4F8FF;strokeColor=#91B4EE;strokeWidth=1.2;fontSize=14;fontStyle=1;fontColor=#1849A9;" vertex="1" parent="1"><mxGeometry x="335" y="225" width="330" height="530" as="geometry"/></mxCell>
        <mxCell id="anas_lane" value="ANAS | SIMULATION &amp; EVALUATION" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=13;spacingLeft=18;fillColor=#F1FBF9;strokeColor=#8EC9BD;strokeWidth=1.2;fontSize=14;fontStyle=1;fontColor=#147363;" vertex="1" parent="1"><mxGeometry x="685" y="225" width="365" height="530" as="geometry"/></mxCell>
        <mxCell id="salman_lane" value="SALMAN | POLICY &amp; SAFETY METHODS" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=13;spacingLeft=18;fillColor=#F8F5FF;strokeColor=#BAA9DF;strokeWidth=1.2;fontSize=14;fontStyle=1;fontColor=#5C4296;" vertex="1" parent="1"><mxGeometry x="1070" y="225" width="665" height="530" as="geometry"/></mxCell>
        <mxCell id="actor" value="Local developer / reviewer&lt;br&gt;&lt;br&gt;Chooses scenario, seed, controller variant; inspects run and results.&lt;br&gt;&lt;br&gt;ScenarioConfig" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=1.8;fontSize=14;fontColor=#172B43;" vertex="1" parent="1"><mxGeometry x="40" y="276" width="235" height="150" as="geometry"/></mxCell>
        <mxCell id="excluded" value="OUTSIDE V1&lt;br&gt;No connections to:&lt;br&gt;• aircraft or live sensors&lt;br&gt;• USS / UTM providers&lt;br&gt;• real registration systems&lt;br&gt;• operational control loops&lt;br&gt;&lt;br&gt;Future integrations need a new service design." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fillColor=#FFFAFA;strokeColor=#C95858;strokeWidth=1.5;dashed=1;dashPattern=7 5;fontSize=13;fontColor=#7E3434;" vertex="1" parent="1"><mxGeometry x="40" y="528" width="235" height="211" as="geometry"/></mxCell>

        <!-- Future service planning lane -->
        <mxCell id="future" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#8797A9;strokeWidth=1.5;dashed=1;dashPattern=9 6;" vertex="1" parent="1"><mxGeometry x="40" y="870" width="1720" height="350" as="geometry"/></mxCell>

        <!-- V1 data-flow connectors; payload names are governed by INTERFACES.md -->
        <mxCell id="e_user_run" value="config / variant" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#40556C;labelBackgroundColor=#F4F7FB;" edge="1" parent="1" source="actor" target="run"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="320" y="350"/><mxPoint x="320" y="478"/></Array></mxGeometry></mxCell>
        <mxCell id="e_api_run" value="synthetic data" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#40556C;labelBackgroundColor=#F4F7FB;" edge="1" parent="1" source="api" target="run"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_run_sim" value="validated ScenarioConfig / reset" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#52677F;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#40556C;labelBackgroundColor=#F4F7FB;" edge="1" parent="1" source="run" target="sim"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="675" y="477"/><mxPoint x="675" y="370"/></Array></mxGeometry></mxCell>
        <mxCell id="e_obs_policy" value="ObservationV1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#15927C;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#40556C;labelBackgroundColor=#F4F7FB;" edge="1" parent="1" source="sim" target="policy"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_policy_filter" value="MARLAction" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7353B8;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#40556C;labelBackgroundColor=#F4F7FB;" edge="1" parent="1" source="policy" target="filter"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_state_filter" value="DroneState for all modeled active agents" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#15927C;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#40556C;labelBackgroundColor=#F4F7FB;" edge="1" parent="1" source="sim" target="filter"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1058" y="405"/><mxPoint x="1058" y="465"/><mxPoint x="1360" y="465"/><mxPoint x="1360" y="405"/></Array></mxGeometry></mxCell>
        <mxCell id="e_filter_safe" value="feasible" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7353B8;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#40556C;labelBackgroundColor=#F4F7FB;" edge="1" parent="1" source="filter" target="safe"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1470" y="480"/><mxPoint x="1215" y="480"/></Array></mxGeometry></mxCell>
        <mxCell id="e_filter_fallback" value="infeasible / error" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#B7791F;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#40556C;labelBackgroundColor=#F4F7FB;" edge="1" parent="1" source="filter" target="fallback"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_safe_sim" value="returned action applied on next simulator step" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7353B8;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#40556C;labelBackgroundColor=#F4F7FB;" edge="1" parent="1" source="safe" target="sim"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1060" y="563"/><mxPoint x="1060" y="445"/></Array></mxGeometry></mxCell>
        <mxCell id="e_fallback_sim" value="returned action applied on next simulator step" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#B7791F;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#40556C;labelBackgroundColor=#F4F7FB;" edge="1" parent="1" source="fallback" target="sim"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1055" y="586"/><mxPoint x="1055" y="445"/></Array></mxGeometry></mxCell>
        <mxCell id="e_step_logger" value="step result" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#15927C;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#40556C;labelBackgroundColor=#F4F7FB;" edge="1" parent="1" source="step" target="logger"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="665" y="565"/><mxPoint x="665" y="672"/></Array></mxGeometry></mxCell>
        <mxCell id="e_manifest_logger" value="manifest" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563EB;strokeWidth=1.8;dashed=1;endArrow=block;endFill=1;fontSize=11;fontColor=#40556C;labelBackgroundColor=#F4F7FB;" edge="1" parent="1" source="run" target="logger"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Future planning arrows -->
        <mxCell id="e_future_1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8797A9;strokeWidth=2;dashed=1;endArrow=block;endFill=1;" edge="1" parent="1" source="f_product" target="f_data"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_future_2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8797A9;strokeWidth=2;dashed=1;endArrow=block;endFill=1;" edge="1" parent="1" source="f_data" target="f_boundary"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_future_3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8797A9;strokeWidth=2;dashed=1;endArrow=block;endFill=1;" edge="1" parent="1" source="f_boundary" target="f_workflow"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_future_4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8797A9;strokeWidth=2;dashed=1;endArrow=block;endFill=1;" edge="1" parent="1" source="f_workflow" target="f_ops"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- V1 component nodes -->
        <mxCell id="api" value="Mock airspace API&lt;br&gt;&lt;font style=&quot;font-size: 12px&quot;&gt;Present baseline • loopback only&lt;br&gt;GET rules / notices&lt;br&gt;POST synthetic registration&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=2;fontSize=15;fontStyle=1;fontColor=#172B43;shadow=1;" vertex="1" parent="1"><mxGeometry x="355" y="275" width="290" height="112" as="geometry"/></mxCell>
        <mxCell id="run" value="Run orchestration&lt;br&gt;&lt;font style=&quot;font-size: 12px&quot;&gt;Planned • validate config, select variant,&lt;br&gt;sequence reset / policy / filter / step,&lt;br&gt;create run manifest.&lt;br&gt;Scenario adapter exists; full loop does not.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=1.8;dashed=1;dashPattern=7 4;fontSize=15;fontStyle=1;fontColor=#172B43;" vertex="1" parent="1"><mxGeometry x="355" y="425" width="290" height="132" as="geometry"/></mxCell>
        <mxCell id="logger" value="Run records &amp; demo&lt;br&gt;&lt;font style=&quot;font-size: 12px&quot;&gt;Planned • manifest, per-step actions,&lt;br&gt;filter flags, timing, episode metrics.&lt;br&gt;Artifact format / storage TBD.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=1.8;dashed=1;dashPattern=7 4;fontSize=15;fontStyle=1;fontColor=#172B43;" vertex="1" parent="1"><mxGeometry x="355" y="610" width="290" height="125" as="geometry"/></mxCell>
        <mxCell id="sim" value="Deterministic simulator&lt;br&gt;&lt;font style=&quot;font-size: 12px&quot;&gt;Planned • owns scenario, ground truth,&lt;br&gt;dynamics, reset / step and termination.&lt;br&gt;Emits policy observations and modeled&lt;br&gt;states; applies returned actions.&lt;br&gt;100 ms / seeded behavior per contract&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fillColor=#FFFFFF;strokeColor=#15927C;strokeWidth=1.8;dashed=1;dashPattern=7 4;fontSize=15;fontStyle=1;fontColor=#172B43;" vertex="1" parent="1"><mxGeometry x="705" y="282" width="325" height="177" as="geometry"/></mxCell>
        <mxCell id="step" value="Step result &amp; evaluation&lt;br&gt;&lt;font style=&quot;font-size: 12px&quot;&gt;Observations, rewards, termination,&lt;br&gt;truncation, info and paired metrics.&lt;br&gt;Matched runs / edge benchmark planned.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fillColor=#FFFFFF;strokeColor=#15927C;strokeWidth=1.8;dashed=1;dashPattern=7 4;fontSize=15;fontStyle=1;fontColor=#172B43;" vertex="1" parent="1"><mxGeometry x="705" y="510" width="325" height="111" as="geometry"/></mxCell>
        <mxCell id="policy" value="Policy adapter&lt;br&gt;&lt;font style=&quot;font-size: 12px&quot;&gt;Planned • reference / MARL&lt;br&gt;Consumes ObservationV1.&lt;br&gt;Produces bounded MARLAction.&lt;br&gt;Proposal only; not a safety controller.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fillColor=#FFFFFF;strokeColor=#7353B8;strokeWidth=1.8;dashed=1;dashPattern=7 4;fontSize=15;fontStyle=1;fontColor=#172B43;" vertex="1" parent="1"><mxGeometry x="1090" y="282" width="250" height="145" as="geometry"/></mxCell>
        <mxCell id="filter" value="CBF / HOCBF QP filter&lt;br&gt;&lt;font style=&quot;font-size: 12px&quot;&gt;Planned • Salman defines equations,&lt;br&gt;assumptions, solver and failure limits.&lt;br&gt;Consumes MARLAction + all required&lt;br&gt;modeled DroneState values.&lt;br&gt;Feasible result carries status.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fillColor=#FFFFFF;strokeColor=#7353B8;strokeWidth=1.8;dashed=1;dashPattern=7 4;fontSize=15;fontStyle=1;fontColor=#172B43;" vertex="1" parent="1"><mxGeometry x="1380" y="282" width="320" height="165" as="geometry"/></mxCell>
        <mxCell id="safe" value="Filter return&lt;br&gt;&lt;font style=&quot;font-size: 12px&quot;&gt;SafeAction (legacy type name)&lt;br&gt;feasible / intervention metadata&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fillColor=#F5F9FF;strokeColor=#7353B8;strokeWidth=1.8;dashed=1;dashPattern=7 4;fontSize=15;fontStyle=1;fontColor=#172B43;" vertex="1" parent="1"><mxGeometry x="1090" y="510" width="250" height="105" as="geometry"/></mxCell>
        <mxCell id="fallback" value="Infeasible / solver error path&lt;br&gt;&lt;font style=&quot;font-size: 12px&quot;&gt;Zero acceleration; qp_feasible=false;&lt;br&gt;fallback_used=true. Unverified.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fillColor=#FFF8E9;strokeColor=#C58A26;strokeWidth=1.8;dashed=1;dashPattern=7 4;fontSize=15;fontStyle=1;fontColor=#8B5C12;" vertex="1" parent="1"><mxGeometry x="1380" y="510" width="320" height="105" as="geometry"/></mxCell>
        <mxCell id="contracts" value="SHARED CONTRACT CROSS-CUT&lt;br&gt;shared/contracts.py + INTERFACES.md • ScenarioConfig • DroneState • ObservationV1 • MARLAction • SafeAction • API/error models" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;fillColor=#EAF2FF;strokeColor=#2563EB;strokeWidth=1.5;fontSize=12;fontColor=#1849A9;" vertex="1" parent="1"><mxGeometry x="335" y="774" width="1400" height="45" as="geometry"/></mxCell>

        <!-- Future service capability cards -->
        <mxCell id="f_heading" value="FUTURE SERVICE DESIGN — AFTER CUSTOMER / OPERATOR DISCOVERY&lt;br&gt;&lt;font style=&quot;font-size: 12px&quot;&gt;Capability view only • exact service role, domain, topology, vendors, and controls remain undecided under P5&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=16;fontStyle=1;fontColor=#172B43;" vertex="1" parent="1"><mxGeometry x="65" y="880" width="1500" height="55" as="geometry"/></mxCell>
        <mxCell id="f_product" value="1. Product definition&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Choose user, workflow, domain,&lt;br&gt;service role and authority boundary.&lt;br&gt;Information / coordination / advice /&lt;br&gt;control influence is a decision.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fillColor=#FFFFFF;strokeColor=#8797A9;strokeWidth=1.5;dashed=1;dashPattern=7 4;fontSize=13;fontStyle=1;fontColor=#172B43;" vertex="1" parent="1"><mxGeometry x="65" y="965" width="275" height="128" as="geometry"/></mxCell>
        <mxCell id="f_data" value="2. Governed data adapters&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Connect selected sources. Define&lt;br&gt;authority, provenance, freshness,&lt;br&gt;quality and outage behavior per feed.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fillColor=#FFFFFF;strokeColor=#8797A9;strokeWidth=1.5;dashed=1;dashPattern=7 4;fontSize=13;fontStyle=1;fontColor=#172B43;" vertex="1" parent="1"><mxGeometry x="385" y="965" width="285" height="128" as="geometry"/></mxCell>
        <mxCell id="f_boundary" value="3. Bounded service boundary&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Specify API, identity/access, partner&lt;br&gt;trust, audit and data handling for&lt;br&gt;the chosen service role.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fillColor=#FFFFFF;strokeColor=#8797A9;strokeWidth=1.5;dashed=1;dashPattern=7 4;fontSize=13;fontStyle=1;fontColor=#172B43;" vertex="1" parent="1"><mxGeometry x="715" y="965" width="285" height="128" as="geometry"/></mxCell>
        <mxCell id="f_workflow" value="4. Service workflow&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Implement the selected user job and&lt;br&gt;explicit failure behavior. Do not assume&lt;br&gt;direct aircraft actuation is in scope.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fillColor=#FFFFFF;strokeColor=#8797A9;strokeWidth=1.5;dashed=1;dashPattern=7 4;fontSize=13;fontStyle=1;fontColor=#172B43;" vertex="1" parent="1"><mxGeometry x="1045" y="965" width="285" height="128" as="geometry"/></mxCell>
        <mxCell id="f_ops" value="5. Operations &amp; evidence&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Specify security, reliability, monitoring,&lt;br&gt;support, assurance and rollback. Validate&lt;br&gt;in stages before permitted operational use.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fillColor=#FFFFFF;strokeColor=#8797A9;strokeWidth=1.5;dashed=1;dashPattern=7 4;fontSize=13;fontStyle=1;fontColor=#172B43;" vertex="1" parent="1"><mxGeometry x="1375" y="965" width="350" height="128" as="geometry"/></mxCell>
        <mxCell id="future_note" value="IMPORTANT BOUNDARY&lt;br&gt;V1 simulation results do not establish operational safety. Zero acceleration is an unverified fallback; this future lane is a planning checklist, not an approved production architecture." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;fillColor=#EEF2F6;strokeColor=#AAB5C2;fontSize=12;fontColor=#40556C;" vertex="1" parent="1"><mxGeometry x="65" y="1120" width="1660" height="65" as="geometry"/></mxCell>
        <mxCell id="legend" value="LEGEND:  Present baseline = solid blue border     •     Planned V1 component = dashed owner-color border     •     Future capability = dashed gray border     •     Arrows = data flow     |     Detailed step sequence: root README     |     Fields / semantics: INTERFACES.md" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;fontColor=#52677F;" vertex="1" parent="1"><mxGeometry x="40" y="1225" width="1720" height="32" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
